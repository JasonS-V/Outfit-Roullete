{
  "expo": {
    "name": "Outfit Roulette",
    "slug": "outfit-roulette",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand-icon.png",
    "scheme": "outfitroulette",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/brand-icon.png",
      "bundleIdentifier": "com.aizendev1.outfitroulette",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#24182F",
        "foregroundImage": "./assets/images/brand-foreground.png",
        "monochromeImage": "./assets/images/brand-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.aizendev1.outfitroulette"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand-favicon.png"
    },
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#24182F",
          "image": "./assets/images/brand-splash.png",
          "imageWidth": 140
        }
      ],
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Outfit Roulette usa tu ubicación aproximada para adaptar los looks al clima de hoy."
        }
      ],
      "expo-asset",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "adae7286-fa3f-45de-ace2-df0c66fe9afd"
      }
    },
    "owner": "aizendev1"
  }
}
